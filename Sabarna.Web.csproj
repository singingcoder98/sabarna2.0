<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Sabarna.Web
    ============
    ASP.NET Core 8 MVC. One project, no client-side framework.
    Razor views are compiled at build time, so a typo in a .cshtml file
    shows up as a build error instead of a 500 page in production.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Sabarna.Web</RootNamespace>
    <AssemblyName>Sabarna.Web</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Nullable reference types are switched OFF on purpose so that a value pulled
      from a database column (which may legitimately be NULL in SQLite) never turns
      into a compiler warning. All entity string properties are still initialised
      to string.Empty so the code never has to chase a null reference.
    -->
    <Nullable>disable</Nullable>

    <!-- Keep the build log clean: no warnings allowed in this project. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core 8 with the file-based SQLite provider (zero setup for the shop owner). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything under wwwroot is static content; nothing else needs publishing rules. -->
    <Content Remove="app.db;app.db-shm;app.db-wal" />
    <None Remove="app.db;app.db-shm;app.db-wal" />
  </ItemGroup>

</Project>
