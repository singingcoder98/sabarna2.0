<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio publish profile for the MonsterASP.NET site (site105374 / sabarna.runasp.net).

  Open it with: right-click the project -> Publish -> "MonsterASP" (it appears in the list once the
  project is reopened), or "Import profile" if Visual Studio has not noticed it yet.

  Two settings matter more than the rest:

    DeleteExistingFiles = False   never wipe the remote folder — App_Data\app.db lives there, and it
                                 holds every order. This is the checkbox that ruins deployments.
    Configuration       = Release the Debug build would ship a slow, chatty app.

  The password is deliberately blank. Visual Studio asks for it the first time (tick "Save password")
  and stores it encrypted in your user profile — never in this file, never in the repository.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://sabarna.runasp.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>

    <!-- Copy values from the panel: Deploy -> FTP / Visual Studio -> "Visual Studio access" tab. -->
    <MSDeployServiceURL>https://site105374.siteasp.net:8172/msdeploy.axd?site=site105374</MSDeployServiceURL>
    <publishUrl>https://site105374.siteasp.net:8172/msdeploy.axd?site=site105374</publishUrl>
    <DeployIisAppPath>site105374</DeployIisAppPath>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <UserName>site105374</UserName>
    <Password></Password>
    <_SavePWD>False</_SavePWD>
    <AllowUntrustedCertificate>True</AllowUntrustedCertificate>
    <UsePowerShell>True</UsePowerShell>

    <!-- Keep everything that is already on the server. -->
    <DeleteExistingFiles>False</DeleteExistingFiles>

    <!-- The local demo database must not travel; the host seeds its own. -->
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <ExcludeFilesFromDeployment>app.db;app.db-shm;app.db-wal</ExcludeFilesFromDeployment>

    <TargetFramework>net8.0</TargetFramework>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
