<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hands ASP.NET Core its instructions here. This file is what makes the published folder run
  on Windows shared hosting (MonsterASP.NET, Azure App Service, any IIS box) without touching the
  control panel.

  Two things are set on purpose:

    ASPNETCORE_ENVIRONMENT=Production   the friendly error page, HSTS, no stack traces
    ConnectionStrings__Default          SQLite lives in App_Data, which IIS makes writable

  Otp__ShowOnScreen is a temporary bridge: no mail provider is connected yet (README §7), so the
  admin's one-time code is drawn on the screen instead of being emailed. Remove that line the day
  delivery is wired up, or anyone who reaches /Admin with your password sees the code.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\Sabarna.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ConnectionStrings__Default" value="Data Source=App_Data\app.db" />
          <!--
            saptarshi: changed 12-Nov-2026, corrected in Phase 0 — the one-time code is e-mailed.
            This is false on purpose. If Email__* is not filled in yet (or the mail server refuses),
            the live site does NOT show the code on screen any more: it says so plainly and stops.
            So before the first sign-in after this update, either make Email__* work, or set this to
            true for one sign-in and put it back to false. (On your own PC, Development, the code is
            still drawn on the screen by itself.)
          -->
          <environmentVariable name="Otp__ShowOnScreen" value="false" />

          <!--
            saptarshi: Phase 0 (12-Nov-2026) — HTTPS.
            The site redirects http -> https and marks both cookies Secure. If your host ever has no
            certificate on the domain, every page would bounce to an address that does not answer;
            in that case add the line below, restart, and the shop serves over http again until the
            certificate is sorted out.

          <environmentVariable name="Security__ForceHttps" value="false" />
          -->

          <!--
            saptarshi: added 06-Nov-2026 — the real secrets go here, on the server only.
            Remove the comment marks, paste your own values, save, and restart the app pool.
            Razorpay is switched on by the first line; until then the shop keeps its demo behaviour.

          <environmentVariable name="Razorpay__Enabled" value="true" />
          <environmentVariable name="Razorpay__KeyId" value="rzp_test_xxxxxxxxxxxx" />
          <environmentVariable name="Razorpay__KeySecret" value="the-secret-from-razorpay" />
          <environmentVariable name="Razorpay__WebhookSecret" value="the-webhook-secret-you-chose" />

          <environmentVariable name="Email__Enabled" value="true" />
          <environmentVariable name="Email__UserName" value="your-brevo-login@example.com" />
          <environmentVariable name="Email__Password" value="the-brevo-smtp-key" />
          <environmentVariable name="Email__FromAddress" value="orders@sabarna.in" />
          <environmentVariable name="Email__OwnerAddress" value="saptarshi@example.com" />
          <environmentVariable name="Email__BackupOwnerAddress" value="another-inbox@example.com" />
          -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
