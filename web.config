<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hands ASP.NET Core its instructions here. This file is what makes the published folder run
  on Windows shared hosting (MonsterASP.NET, Azure App Service, any IIS box) without touching the
  control panel.

  Two things are set on purpose:

    ASPNETCORE_ENVIRONMENT=Production   the friendly error page, HSTS, no stack traces
    ConnectionStrings__Default          SQLite lives in App_Data, which IIS makes writable

  Otp__ShowOnScreen is a temporary bridge: no mail provider is connected yet (README §7), so the
  admin's one-time code is drawn on the screen instead of being emailed. Remove that line the day
  delivery is wired up, or anyone who reaches /Admin with your password sees the code.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\Sabarna.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ConnectionStrings__Default" value="Data Source=App_Data\app.db" />
          <environmentVariable name="Otp__ShowOnScreen" value="true" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
