@model Sabarna.Web.Models.ProductDetailsViewModel
@* saptarshi: 16-Nov-2026 — the base address for the canonical, the OG tags and the Product schema. *@
@inject Microsoft.Extensions.Options.IOptions<Sabarna.Web.Services.SeoOptions> SeoConfig
@{
    var product = Model.Product;
    var image = product.HasImage ? product.Image : "/images/placeholder.svg";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var rounded = (int)Math.Round(product.Rating, MidpointRounding.AwayFromZero);
    var maxQty = Math.Min(product.Stock, CartService.MaxQty);

    // saptarshi: 16-Nov-2026 — keyword-bearing alt text, falling back to the name.
    var seoCopy = Sabarna.Web.Services.ProductContent.For(product);
    var imageAlt = seoCopy?.AltText ?? product.Name;
    if (maxQty < 1)
    {
        maxQty = 1;
    }
}
<section class="mb-product">
    <div class="container">
        <nav aria-label="Breadcrumb" class="mb-crumbs">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span aria-hidden="true">/</span>
            <a asp-controller="Shop" asp-action="Index">Shop</a>
            <span aria-hidden="true">/</span>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="@product.Category">@product.Category</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">@product.Name</span>
        </nav>

        <div class="row g-5 align-items-start">
            <div class="col-lg-6">
                <div class="mb-product-media">
                    <img src="@image" alt="@imageAlt" width="900" height="900" />
                    @if (!string.IsNullOrWhiteSpace(product.Tag))
                    {
                        <span class="mb-product-tag">@product.Tag</span>
                    }
                </div>
                <div class="mb-product-trust">
                    <span>&#128666; Free shipping over &#8377;999</span>
                    <span>&#128230; Padded glass jars</span>
                    <span>&#129530; No preservatives</span>
                </div>
            </div>

            <div class="col-lg-6">
                <p class="mb-kicker mb-kicker-dark">@product.Category</p>
                <h1 class="mb-product-title">@product.Name</h1>
                <p class="mb-product-unit">@product.Unit</p>

                <div class="mb-stars mb-stars-lg" aria-label="@($"{product.Rating:0.0} out of 5 stars from {product.Reviews} reviews")">
                    @for (var star = 1; star <= 5; star++)
                    {
                        <span class="mb-star @(star <= rounded ? "is-on" : string.Empty)" aria-hidden="true">&#9733;</span>
                    }
                    <span class="mb-stars-value">@product.Rating.ToString("0.0") · @product.Reviews reviews</span>
                </div>

                <div class="mb-product-price">
                    <span class="mb-price mb-price-lg">&#8377;@product.Price.ToString("0")</span>
                    @if (product.OnSale)
                    {
                        <span class="mb-price-mrp">MRP &#8377;@product.Mrp.ToString("0")</span>
                        <span class="mb-price-save">save @product.SavePercent%</span>
                    }
                </div>

                @if (product.InStock)
                {
                    <span class="pill pill-green">In stock — @product.Stock jars left</span>
                }
                else
                {
                    <span class="pill pill-red">Out of stock — restocking soon</span>
                }

                <p class="mb-product-desc">@product.Description</p>
                @if (!string.IsNullOrWhiteSpace(product.DescriptionBn))
                {
                    @* saptarshi: 16-Nov-2026 — Bengali for the Bengali customer, marked as Bengali so
                       screen readers and Google both know the language changed. *@
                    <p class="mb-product-desc" lang="bn">@product.DescriptionBn</p>
                }

                @if (product.IsCombo && Model.ComboItems.Count > 0)
                {
                    <div class="mb-product-inside">
                        <h2 class="mb-product-inside-title">What's inside the box</h2>
                        <ul class="mb-combo-chips mb-combo-chips-light">
                            @foreach (var item in Model.ComboItems)
                            {
                                <li class="mb-chip mb-chip-light">
                                    @if (!string.IsNullOrWhiteSpace(item.Image))
                                    {
                                        <img src="@item.Image" alt="" width="26" height="26" loading="lazy" />
                                    }
                                    <span>@item.Name@(string.IsNullOrWhiteSpace(item.Qty) ? string.Empty : " · " + item.Qty)</span>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @* Quantity + add to basket *@
                <form method="post" asp-controller="Cart" asp-action="Add" class="mb-buy-form" data-cart-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@product.Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <div class="mb-qty">
                        <label class="mb-qty-label" for="qty">Quantity</label>
                        <input class="form-control mb-qty-input" type="number" id="qty" name="qty"
                               value="1" min="1" max="@maxQty" step="1" inputmode="numeric"
                               disabled="@(product.InStock ? null : "disabled")" />
                    </div>

                    <button type="submit" class="btn btn-brand btn-lg mb-buy-btn" disabled="@(product.InStock ? null : "disabled")">
                        @(product.InStock ? "Add to basket" : "Out of stock")
                    </button>
                    <a class="btn btn-ghost btn-lg" asp-controller="Cart" asp-action="Index">Go to basket</a>
                </form>

                <ul class="mb-buy-notes">
                    <li>Online payment only — UPI, cards and netbanking. No cash on delivery.</li>
                    <li>Packed on Mondays and Thursdays; tracking link emailed the same evening.</li>
                    <li>Damaged in transit? Photo within 48 hours and we replace the jar.</li>
                </ul>
            </div>
        </div>
    </div>
</section>

@{
    // saptarshi: 16-Nov-2026 — every product page now answers "why would I eat this?" in the shop's
    // own voice. The words live in Services/ProductBenefits.cs so no page can drift from the others.
    var benefits = Sabarna.Web.Services.ProductBenefits.For(product);
}
<section class="mb-section mb-section-cream-2">
    <div class="container">
        <div class="mb-section-head">
            <div>
                <p class="mb-kicker mb-kicker-dark">@benefits.Kicker</p>
                <h2 class="mb-section-title">@benefits.Headline</h2>
            </div>
        </div>
        <p class="mb-section-text">@benefits.Intro</p>
        @if (!string.IsNullOrWhiteSpace(benefits.Focus))
        {
            <p class="mb-section-text mb-benefits-focus">@benefits.Focus</p>
        }
        <div class="row g-4 mt-1">
            @foreach (var card in benefits.Cards)
            {
                <div class="col-md-4">
                    <div class="mb-value-card">
                        <span class="mb-value-icon" aria-hidden="true">@card.Icon</span>
                        <h3 class="mb-value-title">@card.Title</h3>
                        <p class="mb-value-text">@card.Text</p>
                    </div>
                </div>
            }
        </div>
        <div class="mb-note-card mt-4">
            <h3 class="mb-note-title">How we use it at home</h3>
            <p class="mb-note-text">@benefits.Traditional</p>
            <p class="mb-note-fine">@benefits.Fine</p>
        </div>
        <p class="mb-benefits-more">
            <a asp-controller="Home" asp-action="Benefits">Read how we use every jar &rarr;</a>
        </p>
    </div>
</section>

@{
    // saptarshi: 16-Nov-2026 — AEO on the product page: three questions for this shelf, answered in the
    // first sentence, and the same words in FAQPage markup below (Google rejects markup that the page
    // does not show).
    var productFaqs = Sabarna.Web.Services.Faq.ForCategory(product.Category);
}
<section class="mb-section mb-section-cream">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-4">
                <p class="mb-kicker mb-kicker-dark">Before you buy</p>
                <h2 class="mb-section-title">Questions about this jar</h2>
                <p class="mb-section-text">
                    The three things people ask us most about this shelf. Anything else — WhatsApp us and a
                    person from the kitchen replies, usually within a few hours.
                </p>
            </div>
            <div class="col-lg-8">
                <div class="accordion mb-faq" id="productFaq">
                    @{ var faqNumber = 0; }
                    @foreach (var item in productFaqs)
                    {
                        faqNumber++;
                        var headId = $"productFaqHead{faqNumber}";
                        var bodyId = $"productFaqBody{faqNumber}";
                        var isOpen = faqNumber == 1;

                        <div class="accordion-item">
                            <h3 class="accordion-header" id="@headId">
                                <button class="accordion-button @(isOpen ? string.Empty : "collapsed")" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#@bodyId"
                                        aria-expanded="@(isOpen ? "true" : "false")" aria-controls="@bodyId">
                                    @item.Question
                                </button>
                            </h3>
                            <div id="@bodyId" class="accordion-collapse collapse @(isOpen ? "show" : string.Empty)"
                                 aria-labelledby="@headId" data-bs-parent="#productFaq">
                                <div class="accordion-body">
                                    @item.Answer
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script type="application/ld+json">@Html.Raw(Sabarna.Web.Services.Faq.SchemaJson(productFaqs))</script>

@if (Model.Related.Count > 0)
{
    <section class="mb-section mb-section-cream">
        <div class="container">
            <div class="mb-section-head">
                <div>
                    <p class="mb-kicker mb-kicker-dark">Pairs well with</p>
                    <h2 class="mb-section-title">You may also like</h2>
                </div>
                <a class="btn btn-ghost" asp-controller="Shop" asp-action="Index" asp-route-category="@product.Category">
                    More @product.Category
                </a>
            </div>
            <div class="row g-4">
                @foreach (var related in Model.Related)
                {
                    <div class="col-6 col-lg-4">
                        <partial name="_ProductCard" model="related" />
                    </div>
                }
            </div>
        </div>
    </section>
}

@{
    // ---- search engine furniture for this one jar -------------------------------------------
    // These ViewData values are read by _Head, which renders after the body, so setting them
    // here works exactly like setting them in the controller.
    // saptarshi: 16-Nov-2026 — configured base URL (appsettings "Seo": { "BaseUrl": … }).
    var seoOrigin = SeoConfig.Value.Origin(Context.Request);
    var seoPageUrl = seoOrigin + Context.Request.Path;
    var seoTrail = new List<(string Name, string Url)>
    {
        ("Home", seoOrigin + "/"),
        ("Shop", seoOrigin + "/Shop"),
        (product.Category, seoOrigin + "/Shop?category=" + Uri.EscapeDataString(product.Category)),
        (product.Name, seoPageUrl)
    };

    ViewData["OgType"] = "product";
    ViewData["OgImage"] = image;
}

@* Product: name, image, price, currency and whether it is in stock. This is what turns a plain
   blue link into a result with a price under it. BreadcrumbList: the trail rather than a raw URL. *@
<script type="application/ld+json">
    @Html.Raw(StructuredData.Product(product, Model.Settings.BrandName, seoPageUrl, seoOrigin + image))
</script>
<script type="application/ld+json">
    @Html.Raw(StructuredData.Breadcrumbs(seoTrail))
</script>
