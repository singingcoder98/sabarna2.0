@model Sabarna.Web.Models.AdminOrdersViewModel
@{
    Layout = "_AdminLayout";

    var filters = new List<string> { "All" };
    filters.AddRange(OrderStatuses.All);

    // Route value for the filter pill: null (i.e. no query string) means "All".
    string statusRoute = Model.Status == "All" ? null : Model.Status;
    var searchTerm = string.IsNullOrWhiteSpace(Model.Search) ? null : Model.Search;
}
<div class="mb-admin-head">
    <div>
        <h1 class="mb-admin-title">Orders</h1>
        <p class="mb-admin-sub">
            Advance a parcel one step at a time, or set its status directly when something changes.
        </p>
    </div>
    <div class="mb-admin-head-actions">
        <a class="btn btn-ghost btn-sm" asp-controller="Admin" asp-action="ExportOrders" asp-route-status="@statusRoute">
            Export CSV
        </a>
        <a class="btn btn-ghost btn-sm" asp-controller="Admin" asp-action="Dashboard">Back to dashboard</a>
    </div>
</div>

<div class="mb-admin-panel">
    <div class="mb-admin-panel-head mb-admin-panel-head-wrap">
        <div class="mb-filter mb-filter-admin" role="group" aria-label="Filter orders by status">
            @foreach (var status in filters)
            {
                var isActive = Model.Status == status;
                var count = Model.CountsByStatus.TryGetValue(status, out var value) ? value : 0;
                var route = status == "All" ? null : status;

                <a class="mb-pill @(isActive ? "is-active" : string.Empty)"
                   asp-controller="Admin" asp-action="Orders" asp-route-status="@route" asp-route-search="@searchTerm">
                    @status <span class="mb-pill-count">@count</span>
                </a>
            }
        </div>

        <form method="get" asp-controller="Admin" asp-action="Orders" class="mb-admin-search" role="search">
            <label class="visually-hidden" for="orderSearch">Search orders</label>
            <input class="form-control form-control-sm" id="orderSearch" type="search" name="search"
                   value="@Model.Search" placeholder="Order number, name or email" />
            @if (searchTerm != null)
            {
                <input type="hidden" name="status" value="@statusRoute" />
            }
            <button class="btn btn-ghost btn-sm" type="submit">Search</button>
            @if (searchTerm != null)
            {
                <a class="btn btn-ghost btn-sm" asp-controller="Admin" asp-action="Orders" asp-route-status="@statusRoute">Clear</a>
            }
        </form>
    </div>

    <p class="mb-admin-today">
        Showing <strong>@Model.FilteredCount</strong> of @Model.TotalCount orders &middot;
        &#8377;@Model.FilteredValue.ToString("#,##0") on this screen.
        @if (searchTerm != null)
        {
            <span>Filtered by &ldquo;@Model.Search&rdquo;.</span>
        }
    </p>

    @if (Model.Orders.Count == 0)
    {
        <p class="mb-admin-empty">
            @(searchTerm == null
                ? "No orders in this state right now."
                : "Nothing matches that search. Try a different name, email or order number.")
        </p>
    }
    else
    {
        <div class="mb-table-wrap">
            <table class="table mb-table mb-table-admin align-middle">
                <caption class="visually-hidden">Orders, newest first</caption>
                <thead>
                    <tr>
                        <th scope="col">Order</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Items</th>
                        <th scope="col">Total</th>
                        <th scope="col">Payment</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Change status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>
                                <span class="mb-table-strong">@order.OrderNumber</span>
                                <span class="mb-table-sub">@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</span>
                            </td>
                            <td>
                                <span class="mb-table-strong">@order.Customer</span>
                                <span class="mb-table-sub">@order.Email</span>
                                <span class="mb-table-sub mb-table-sub-quiet">@order.ProductName</span>
                            </td>
                            <td class="mb-table-num">@order.ItemCount</td>
                            <td class="mb-table-num">&#8377;@order.Total.ToString("#,##0")</td>
                            <td>
                                <span class="pill pill-green">@order.Payment</span>
                                <span class="mb-table-sub">@order.PaymentMethod</span>
                            </td>
                            <td><span class="pill @OrderStatuses.PillClass(order.Status)">@order.Status</span></td>
                            <td class="text-end">
                                <div class="mb-order-actions">
                                    @if (order.Status != OrderStatuses.Delivered)
                                    {
                                        <form method="post" asp-controller="Admin" asp-action="AdvanceOrder">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@order.Id" />
                                            <input type="hidden" name="filter" value="@statusRoute" />
                                            <input type="hidden" name="search" value="@searchTerm" />
                                            <button type="submit" class="btn btn-outline-brand btn-sm">
                                                Mark @OrderStatuses.Next(order.Status)
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="mb-table-sub">Completed</span>
                                    }

                                    <form method="post" asp-controller="Admin" asp-action="SetOrderStatus" class="mb-status-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <input type="hidden" name="filter" value="@statusRoute" />
                                        <input type="hidden" name="search" value="@searchTerm" />
                                        <label class="visually-hidden" for="status-@order.Id">Status for @order.OrderNumber</label>
                                        <select class="form-select form-select-sm" id="status-@order.Id" name="status">
                                            @foreach (var option in OrderStatuses.All)
                                            {
                                                // Hoisted: a quoted literal inside the attribute is easy to misread.
                                                var isCurrent = option == order.Status ? "selected" : null;

                                                <option value="@option" selected="@isCurrent">@option</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-ghost btn-sm">Set</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<p class="mb-admin-fine">
    <strong>Note:</strong> the customer is not emailed when the status changes yet — that is on the
    deferred list, together with the payment gateway. Today the change is visible in the admin only.
</p>
