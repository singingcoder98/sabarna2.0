@model Sabarna.Web.Models.OtpViewModel
@using Microsoft.EntityFrameworkCore
@* AsNoTracking() is an EF Core extension method, and Razor does not import this namespace
   for you — that is why this line is here rather than in _ViewImports. *@
@inject Sabarna.Web.Data.AppDbContext Db
@{
    Layout = null;

    // A sign-in screen has no business in a search index.
    ViewData["Robots"] = "noindex, nofollow";
    var store = Db.Settings.AsNoTracking().FirstOrDefault()
                ?? new SiteSetting { BrandName = "Sabarna", Tagline = "Small-batch ghee, honey & pickles" };
    var devCode = ViewData["DevCode"] as string;
}
<!DOCTYPE html>
<html lang="en-IN">
<head>
    <partial name="_Head" model="store" />
</head>
<body class="mb-auth-body">
<div class="mb-auth">
    <section class="mb-auth-visual mb-auth-visual-otp" aria-labelledby="otpHeading">
        <div class="mb-auth-visual-inner">
            <a class="mb-auth-brand" asp-controller="Home" asp-action="Index">
                <img src="/images/logo-mark.png" alt="" width="44" height="44" aria-hidden="true" />
                <span>@store.BrandName</span>
            </a>
            <h1 class="mb-auth-visual-title" id="otpHeading">
                Almost in,<br />step 2 of 2
            </h1>
            <p class="mb-auth-visual-text">
                Your password was accepted. The six-digit code proves it is really you holding the
                phone — it expires five minutes after it is created and works only once.
            </p>
            <ul class="mb-auth-list">
                <li>Wrong code five times and the code is burnt; sign in again.</li>
                <li>Never share the code with anyone, including someone claiming to be us.</li>
            </ul>
        </div>
    </section>

    <section class="mb-auth-form-side" aria-label="One-time code">
        <div class="mb-auth-card">
            <a class="mb-auth-back" asp-controller="Admin" asp-action="Login">&larr; Start again</a>

            <h2 class="mb-auth-title">Enter the code</h2>
            <p class="mb-auth-step">Step 2 of 2 — the six-digit code</p>

            @if (!string.IsNullOrWhiteSpace(devCode))
            {
                <div class="mb-dev-notice" role="status">
                    <p class="mb-dev-notice-title">No email is sent yet</p>
                    <p class="mb-dev-notice-text">
                        Your one-time code is <strong class="mb-dev-code">@devCode</strong>
                    </p>
                    <p class="mb-dev-notice-fine">
                        This box appears because <code>Otp:ShowOnScreen</code> is on, or because the
                        site is running in Development. Connect a mail provider (README §7) and
                        switch it off.
                    </p>
                </div>
            }

            <form method="post" asp-controller="Admin" asp-action="VerifyOtp" class="mb-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="mb-form-errors"></div>

                <div class="mb-field">
                    <label class="form-label" asp-for="Code">Six-digit code</label>
                    <input class="form-control mb-otp-input" asp-for="Code" inputmode="numeric"
                           autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}"
                           placeholder="000000" autofocus />
                    <span class="mb-field-error" asp-validation-for="Code"></span>
                </div>

                <button type="submit" class="btn btn-brand btn-lg w-100">Verify and sign in</button>
            </form>

            <p class="mb-auth-fine">
                Codes are stored only as a SHA-256 hash, so nobody — including us — can read them back.
            </p>
        </div>
    </section>
</div>

@{
    // The auth screens are standalone pages, so they need their own toast container.
    var authToast = TempData["Toast"] as string;
    var authError = TempData["Error"] as string;
}
<div class="toast-container position-fixed bottom-0 end-0 p-3 mb-toast-stack" aria-live="polite" aria-atomic="true">
    @if (!string.IsNullOrWhiteSpace(authToast))
    {
        <div class="toast mb-toast mb-toast-success" role="status" aria-live="polite" aria-atomic="true" data-autoshow="true">
            <div class="d-flex">
                <div class="toast-body">@authToast</div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(authError))
    {
        <div class="toast mb-toast mb-toast-error" role="alert" aria-live="assertive" aria-atomic="true" data-autoshow="true">
            <div class="d-flex">
                <div class="toast-body">@authError</div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
</div>

<partial name="_Scripts" />
</body>
</html>
