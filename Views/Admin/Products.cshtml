@model List<Matibari.Web.Models.Product>
@{
    Layout = "_AdminLayout";
    var categories = Model
        .Select(product => product.Category)
        .Where(category => !string.IsNullOrWhiteSpace(category))
        .Distinct()
        .OrderBy(category => category)
        .ToList();
    var liveCount = Model.Count(product => product.Active);
}
<div class="mb-admin-head">
    <div>
        <h1 class="mb-admin-title">Products</h1>
        <p class="mb-admin-sub">
            @Model.Count products in the catalogue, @liveCount visible in the shop.
            Changes appear on the storefront immediately.
        </p>
    </div>
    <div class="mb-admin-head-actions">
        <button type="button" class="btn btn-brand btn-sm" data-bs-toggle="modal" data-bs-target="#newProduct">
            Add a product
        </button>
    </div>
</div>

<div class="mb-admin-panel">
    @if (Model.Count == 0)
    {
        <p class="mb-admin-empty">No products yet. Use "Add a product" to put the first jar on the shelf.</p>
    }
    else
    {
        <div class="mb-table-wrap">
            <table class="table mb-table mb-table-admin align-middle">
                <caption class="visually-hidden">Every product in the catalogue</caption>
                <thead>
                    <tr>
                        <th scope="col" class="mb-col-thumb">Jar</th>
                        <th scope="col">Name</th>
                        <th scope="col">Price</th>
                        <th scope="col">Stock</th>
                        <th scope="col">Type</th>
                        <th scope="col">Visibility</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                <img class="mb-admin-thumb"
                                     src="@(product.HasImage ? product.Image : "/images/placeholder.svg")"
                                     alt="" width="52" height="52" loading="lazy" />
                            </td>
                            <td>
                                <span class="mb-table-strong">@product.Name</span>
                                <span class="mb-table-sub">@product.Category · @product.Unit</span>
                                @if (product.Featured)
                                {
                                    <span class="pill pill-gold pill-xs">Featured</span>
                                }
                            </td>
                            <td class="mb-table-num">
                                &#8377;@product.Price.ToString("#,##0")
                                @if (product.OnSale)
                                {
                                    <span class="mb-table-sub">MRP &#8377;@product.Mrp.ToString("#,##0")</span>
                                }
                            </td>
                            <td>
                                @if (product.Stock == 0)
                                {
                                    <span class="pill pill-red">Out</span>
                                }
                                else if (product.Stock <= 10)
                                {
                                    <span class="pill pill-amber">@product.Stock left</span>
                                }
                                else
                                {
                                    <span class="pill pill-green">@product.Stock</span>
                                }
                            </td>
                            <td>
                                @if (product.IsCombo)
                                {
                                    <span class="pill pill-grey">Combo</span>
                                }
                                else
                                {
                                    <span class="pill pill-grey">Single</span>
                                }
                            </td>
                            <td>
                                <form method="post" asp-controller="Admin" asp-action="ToggleProduct">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@product.Id" />
                                    <button type="submit" class="mb-switch @(product.Active ? "is-on" : string.Empty)"
                                            aria-label="@(product.Active ? "Hide this product from the shop" : "Show this product in the shop")">
                                        <span class="mb-switch-track"><span class="mb-switch-dot"></span></span>
                                        <span class="mb-switch-label">@(product.Active ? "Live" : "Hidden")</span>
                                    </button>
                                </form>
                            </td>
                            <td class="text-end">
                                <div class="mb-row-actions">
                                    <button type="button" class="btn btn-ghost btn-sm"
                                            data-bs-toggle="modal" data-bs-target="#edit-@product.Id">
                                        Edit
                                    </button>
                                    <form method="post" asp-controller="Admin" asp-action="DeleteProduct"
                                          data-confirm="Delete &quot;@(product.Name)&quot;? Past orders keep their own copy, but the jar leaves the shop for good.">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@product.Id" />
                                        <button type="submit" class="btn btn-ghost btn-sm mb-btn-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<p class="mb-admin-fine">
    <strong>Tip:</strong> "Hidden" takes a jar off the shop without losing its history. Delete only when
    the product will never come back.
</p>

@* Shared list of categories for the datalist in every form below. *@
<datalist id="categoryOptions">
    @foreach (var category in categories)
    {
        <option value="@category"></option>
    }
</datalist>

@* ------------------------------- Add product modal ------------------------------- *@
<div class="modal fade" id="newProduct" tabindex="-1" aria-labelledby="newProductLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content mb-modal">
            <form method="post" asp-controller="Admin" asp-action="SaveProduct">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title mb-modal-title" id="newProductLabel">Add a product</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @* A blank Product: Active defaults to true and ComboItemsJson defaults to "[]". *@
                    <partial name="_ProductFormFields" model="new Matibari.Web.Models.Product()" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-brand btn-sm">Save product</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ------------------------------- Edit modals ------------------------------- *@
@foreach (var product in Model)
{
    <div class="modal fade" id="edit-@product.Id" tabindex="-1" aria-labelledby="editLabel-@product.Id" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content mb-modal">
                <form method="post" asp-controller="Admin" asp-action="SaveProduct">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@product.Id" />
                    <div class="modal-header">
                        <h2 class="modal-title mb-modal-title" id="editLabel-@product.Id">Edit “@product.Name”</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <partial name="_ProductFormFields" model="product" />
                    </div>
                    <div class="modal-footer">
                        <span class="mb-modal-meta">Sold so far: @product.Sold</span>
                        <button type="button" class="btn btn-ghost btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-brand btn-sm">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
