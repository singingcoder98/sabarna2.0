@model Sabarna.Web.Models.SiteSetting
@*
    saptarshi: 16-Nov-2026 — "Health & tradition". The owner asked for the benefits of each item to
    be on the site, in a brand/PR voice: hair, skin, digestion, strength. It is written the way a
    careful shop can write it — what the food contains, and how a Bengali household has always used
    it — and never as a medical claim, because a food business in India may not make one.

    Nothing here is new design: the page is built out of the sections, cards and note boxes the rest
    of the site already uses (mb-page-head, mb-section, mb-value-card, mb-note-card, mb-prose).
*@
@{
    var panels = new[]
    {
        Sabarna.Web.Services.ProductBenefits.ForCategory("Pickles"),
        Sabarna.Web.Services.ProductBenefits.ForCategory("Bori"),
        Sabarna.Web.Services.ProductBenefits.ForCategory("Honey")
    };
}

<section class="mb-page-head mb-page-head-dark">
    <div class="container">
        <nav aria-label="Breadcrumb" class="mb-crumbs mb-crumbs-light">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Health &amp; tradition</span>
        </nav>
        <h1 class="mb-page-title">What is in the jar, and what it has always been used for</h1>
        <p class="mb-page-text">
            We are a kitchen, not a clinic. But every jar here has a history in a Bengali household,
            and most of that history is about the body: mustard oil for hair, honey for a throat, dal for
            strength, a piece of achar so the rice goes down. This page says what each one brings to a
            plate — and, just as plainly, what we are not claiming.
        </p>
    </div>
</section>

@for (var i = 0; i < panels.Length; i++)
{
    var panel = panels[i];
    var sectionClass = i % 2 == 0 ? "mb-section mb-section-cream" : "mb-section mb-section-cream-2";

    <section class="@sectionClass">
        <div class="container">
            <div class="mb-section-head">
                <div>
                    <p class="mb-kicker mb-kicker-dark">@panel.Kicker</p>
                    <h2 class="mb-section-title">@panel.Headline</h2>
                </div>
            </div>
            <p class="mb-section-text mb-benefits-intro">@panel.Intro</p>
            <div class="row g-4 mt-1">
                @foreach (var card in panel.Cards)
                {
                    <div class="col-md-4">
                        <div class="mb-value-card">
                            <span class="mb-value-icon" aria-hidden="true">@card.Icon</span>
                            <h3 class="mb-value-title">@card.Title</h3>
                            <p class="mb-value-text">@card.Text</p>
                        </div>
                    </div>
                }
            </div>
            <div class="mb-note-card mt-4">
                <h3 class="mb-note-title">How we use it at home</h3>
                <p class="mb-note-text">@panel.Traditional</p>
                <p class="mb-note-fine">@panel.Fine</p>
            </div>
        </div>
    </section>
}

<section class="mb-section mb-section-cream">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7">
                <p class="mb-kicker mb-kicker-dark">Straight talk</p>
                <h2 class="mb-section-title">This is food, not medicine</h2>
                <div class="mb-prose">
                    <p>
                        Nothing on this page treats, cures or prevents a disease, and nothing here is a
                        substitute for a doctor. What we can say is what is in the jar — dal, fruit,
                        mustard oil, salt, honey — and how a household used it for generations before
                        anybody thought to put it in a bottle.
                    </p>
                    <p>
                        If you have a condition that makes salt, sugar or oil matter — diabetes, high blood
                        pressure, acidity, a pregnancy — ask your own doctor how much of which jar suits
                        you. We would rather lose a sale than make a claim we cannot stand behind.
                    </p>
                    <p>
                        One warning we will never soften: <strong>never give honey to a child under one
                        year</strong>, and never boil raw honey.
                    </p>
                </div>
                <a class="btn btn-brand mt-2" asp-controller="Shop" asp-action="Index">See everything on the shelf</a>
            </div>
            <div class="col-lg-5">
                <div class="mb-note-card">
                    <h3 class="mb-note-title">The three lines we will not cross</h3>
                    <ul class="mb-note-list">
                        <li>We will not print a health claim on a label. It is against FSSAI rules for a food business without approval, and it is dishonest besides.</li>
                        <li>We will not say "cures", "treats", "prevents" or "boosts immunity". Words like that have ended shops bigger than ours.</li>
                        <li>We will not put a number on it — no "twice the protein", no "100% vitamin C" — unless we have a lab report to show you.</li>
                    </ul>
                    <p class="mb-note-fine">
                        Questions about any ingredient? WhatsApp us on @Model.Whatsapp or write to @Model.Email — a person answers, not a bot.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
