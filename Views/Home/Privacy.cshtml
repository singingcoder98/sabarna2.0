@using Microsoft.EntityFrameworkCore
@inject Sabarna.Web.Data.AppDbContext Db
@* saptarshi: 13-Nov-2026 — the address comes from /Admin/Settings, not from this file, so the
   owner can change it in one place and every page follows. *@
@{
    var shop = Db.Settings.AsNoTracking().FirstOrDefault();
    var shopEmail = string.IsNullOrWhiteSpace(shop?.Email) ? "orders.sabarna@gmail.com" : shop!.Email;
}

<section class="mb-page-head">
    <div class="container">
        <nav aria-label="Breadcrumb" class="mb-crumbs">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span aria-hidden="true">/</span>
            <a asp-controller="Home" asp-action="Policies">Policies</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Privacy</span>
        </nav>
        <h1 class="mb-page-title">Privacy policy</h1>
        <p class="mb-page-text">Last updated 1 November 2026. Roughly four minutes to read.</p>
    </div>
</section>

<section class="mb-section mb-section-cream-2">
    <div class="container">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-8">
                <div class="mb-prose">
                    <h2>What we collect when you order</h2>
                    <p>
                        Your name, email address, mobile number and delivery address — nothing more. We need
                        all four to get a glass jar to your door and to call you if the courier cannot find
                        the building.
                    </p>

                    <h2>What we store on your device</h2>
                    <p>
                        One session cookie, which holds your basket while you shop, and one cookie that keeps
                        an admin signed in. There are no advertising cookies, no tracking pixels and no
                        third-party analytics scripts on this site.
                    </p>

                    <h2>Who else sees your details</h2>
                    <ul>
                        <li>Our courier partner sees your name, address and phone number — that is how a parcel travels.</li>
                        <li>Our payment provider sees what it needs to take the payment. We never see your card number.</li>
                        <li>Nobody else. We do not sell, rent or trade customer data, and we do not run advertising lists.</li>
                    </ul>

                    <h2>How long we keep it</h2>
                    <p>
                        Order records are kept for eight years because tax law requires it. Newsletter
                        addresses are kept until you unsubscribe. Ask us and we will delete anything we are
                        not legally required to keep.
                    </p>

                    <h2>Your choices</h2>
                    <p>
                        Write to <a href="mailto:@shopEmail">@shopEmail</a> to see, correct or
                        delete the information we hold about you. We answer within two working days and we
                        will not ask you to justify the request.
                    </p>

                    <h2>Children</h2>
                    <p>
                        The shop is meant for adults. We do not knowingly collect information from anyone
                        under 18. If you think a child has ordered, tell us and we will remove the record.
                    </p>

                    <h2>Changes to this policy</h2>
                    <p>
                        If we change anything important we will note it at the top of this page with a new
                        date. We will not quietly rewrite a promise.
                    </p>
                </div>
            </div>

            <div class="col-lg-4">
                <aside class="mb-note-card mb-note-card-sticky">
                    <h2 class="mb-note-title">The short version</h2>
                    <p class="mb-note-text">
                        We keep your name, address, email and phone so we can deliver a parcel and answer
                        your questions. We never sell your data. No trackers, no ad pixels.
                    </p>
                    <a class="btn btn-outline-brand btn-sm mt-2" href="mailto:@shopEmail">Ask a privacy question</a>
                </aside>
            </div>
        </div>
    </div>
</section>
