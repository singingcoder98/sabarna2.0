@model Sabarna.Web.Models.SiteSetting
<section class="mb-page-head mb-page-head-dark">
    <div class="container">
        <nav aria-label="Breadcrumb" class="mb-crumbs mb-crumbs-light">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Our story</span>
        </nav>
        <h1 class="mb-page-title">A farm that never got bigger than it needed to</h1>
        <p class="mb-page-text">
            @Model.BrandName has been bottling ghee in the same courtyard since 2016. Eleven of us work here,
            and four Gir cows decide how much ghee exists in any given month.
        </p>
    </div>
</section>

<section class="mb-section mb-section-cream">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <div class="mb-about-media">
                    <img src="/images/about-farm.jpg"
                         alt="Hands churning butter in a clay pot in the Sabarna courtyard"
                         width="900" height="700" loading="lazy" />
                    <span class="mb-about-stamp">Midnapore</span>
                </div>
            </div>
            <div class="col-lg-6">
                <p class="mb-kicker mb-kicker-dark">The long version</p>
                <h2 class="mb-section-title">We did not start a brand. We started selling what was spare.</h2>
                <p class="mb-section-text">
                    Our grandfather kept four cows behind the house in Kharagpur and sold the extra milk to
                    neighbours. When the milk could not be sold, it became curd; when the curd was not
                    eaten, the butter was churned and simmered into ghee. That ghee left the house in steel
                    dabbas, for people who asked for it by name.
                </p>
                <p class="mb-section-text">
                    In 2016 we put it in glass jars with a date written by hand and started posting them. That
                    is the whole origin story — no investors, no factory, no master plan. We still make about
                    eighty jars of ghee a month because that is what four cows can honestly supply.
                </p>
                <p class="mb-section-text">
                    The honey comes from honey-gathering families in the sal forests behind the village, and
                    the pickles are cured on the roof by the same three women who have been doing it since
                    before we had a website.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="mb-section mb-section-cream-2">
    <div class="container">
        <div class="mb-section-head">
            <div>
                <p class="mb-kicker mb-kicker-dark">Three promises</p>
                <h2 class="mb-section-title">What we will and will not do</h2>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="mb-promise-card">
                    <span class="mb-promise-num">01</span>
                    <h3 class="mb-promise-title">We will say what is in the jar</h3>
                    <p class="mb-promise-text">
                        One ingredient, or two if it is a pickle. No "permitted flavours", no palm oil, no
                        colour. The label is the whole recipe.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-promise-card">
                    <span class="mb-promise-num">02</span>
                    <h3 class="mb-promise-title">We will not sell what we cannot make</h3>
                    <p class="mb-promise-text">
                        When the month's ghee is gone, the button says out of stock and stays that way. We would
                        rather lose an order than buy in from somewhere else.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-promise-card">
                    <span class="mb-promise-num">03</span>
                    <h3 class="mb-promise-title">We will answer you ourselves</h3>
                    <p class="mb-promise-text">
                        Every message reaches a person in the farm office. No bots, no "ticket closed"
                        auto-replies, no call centre reading from a script.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-section mb-section-cream">
    <div class="container">
        <div class="mb-section-head">
            <div>
                <p class="mb-kicker mb-kicker-dark">The making</p>
                <h2 class="mb-section-title">Two days, start to finish</h2>
            </div>
        </div>
        <ol class="mb-process">
            <li class="mb-process-step">
                <span class="mb-process-num">01</span>
                <h3 class="mb-process-title">5 am — milking</h3>
                <p class="mb-process-text">Twelve litres, give or take. Milked by hand, strained twice.</p>
            </li>
            <li class="mb-process-step">
                <span class="mb-process-num">02</span>
                <h3 class="mb-process-title">9 am — setting</h3>
                <p class="mb-process-text">Milk is cooled and set with a spoon of yesterday's curd.</p>
            </li>
            <li class="mb-process-step">
                <span class="mb-process-num">03</span>
                <h3 class="mb-process-title">Next morning — churning</h3>
                <p class="mb-process-text">The wooden bilona turns for about an hour until butter separates.</p>
            </li>
            <li class="mb-process-step">
                <span class="mb-process-num">04</span>
                <h3 class="mb-process-title">Then — six hours on wood</h3>
                <p class="mb-process-text">Simmered until the milk solids turn amber, then strained into glass.</p>
            </li>
        </ol>
    </div>
</section>

<section class="mb-section mb-section-cream-2">
    <div class="container">
        <div class="mb-banner">
            <div>
                <h2 class="mb-banner-title">Come and see it if you are nearby</h2>
                <p class="mb-banner-text">
                    @Model.Address. Visitors are welcome on packing days; call ahead so we can put the kettle on.
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-brand" asp-controller="Shop" asp-action="Index">Shop the jars</a>
                <a class="btn btn-ghost" asp-controller="Contact" asp-action="Index">Talk to us</a>
            </div>
        </div>
    </div>
</section>
